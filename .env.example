# Copy to .env and replace every placeholder before starting the stack.
POSTGRES_DB=assetclient
POSTGRES_USER=assetclient
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
WEB_PORT=8080
# Set to the exact public origin, including scheme and port. Example: https://asset.example.it
APP_ORIGIN=http://localhost:8080
# Optional first administrator. Only created if the username does not already exist.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_PASSWORD_OF_AT_LEAST_12_CHARACTERS

# Optional Webex read-only connector. Store real values only in the server secret store.
# Requires an administrator-approved token with the minimum read scope for the Devices API.
WEBEX_ACCESS_TOKEN=
# Optional Cisco Support EoX API credentials for product lifecycle lookup.
# Register the app in Cisco API Console with Support APIs / EoX access.
CISCO_EOX_CLIENT_ID=
CISCO_EOX_CLIENT_SECRET=
